# Supabase PostgreSQL Database Credentials (Optional for Cloud Sync)
# If empty, ACUCARE uses the high-performance persistent local relational database engine automatically.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

